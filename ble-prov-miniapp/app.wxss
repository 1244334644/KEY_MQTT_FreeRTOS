/**app.wxss**/
.container {
  padding: 20px;
}

.status {
  padding: 15px;
  background: #f5f5f5;
  border-radius: 8px;
  margin-bottom: 20px;
  text-align: center;
  font-size: 14px;
}

.input-section {
  margin-bottom: 20px;
}

.input-item {
  display: flex;
  align-items: center;
  margin-bottom: 15px;
}

.input-item text {
  width: 80px;
  font-size: 14px;
}

.input-item input {
  flex: 1;
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 8px;
}

button {
  margin-top: 15px;
}

.device-list {
  margin-top: 20px;
  margin-bottom: 20px;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
  background: #f9f9f9;
  border-radius: 8px;
  margin-bottom: 10px;
}

.device-item:active {
  background: #eee;
}

.rssi {
  color: #888;
  font-size: 12px;
}
