/* pages/index/index.wxss */
.container {
  padding: 20px;
}

.status {
  padding: 15px;
  background: #e8f5e9;
  border-radius: 8px;
  margin-bottom: 20px;
  text-align: center;
  font-size: 14px;
  color: #2e7d32;
}

.section-title {
  font-size: 14px;
  color: #666;
  margin: 15px 0 10px;
}

.input-section {
  background: #fff;
  border-radius: 8px;
  padding: 10px;
  margin-bottom: 15px;
}

.input-item {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #f0f0f0;
}

.input-item:last-child {
  border-bottom: none;
}

.input-item text {
  width: 80px;
  font-size: 14px;
  color: #333;
}

.input-item input {
  flex: 1;
  font-size: 14px;
}

button {
  margin-top: 10px;
  border-radius: 8px;
}

.device-list {
  margin: 10px 0;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
  background: #fff;
  border-radius: 8px;
  margin-bottom: 10px;
  border: 1px solid #eee;
}

.device-item:active {
  background: #f5f5f5;
}

.device-name {
  font-size: 14px;
  color: #333;
}

.rssi {
  color: #888;
  font-size: 12px;
}
