<!--pages/index/index.wxml-->
<view class="container">
  <!-- 状态显示 -->
  <view class="status">{{status}}</view>
  
  <!-- WiFi 输入区域 -->
  <view class="section-title">WiFi 配置</view>
  <view class="input-section">
    <view class="input-item">
      <text>WiFi 名称:</text>
      <input placeholder="请输入WiFi名称" value="{{ssid}}" bindinput="onSsidInput" />
    </view>
    <view class="input-item">
      <text>WiFi 密码:</text>
      <input placeholder="请输入WiFi密码" password value="{{password}}" bindinput="onPasswordInput" />
    </view>
  </view>
  
  <!-- 扫描按钮 -->
  <button type="primary" bindtap="scanDevices">扫描设备</button>
  
  <!-- 设备列表 -->
  <view class="section-title" wx:if="{{devices.length > 0}}">发现设备</view>
  <view class="device-list">
    <block wx:for="{{devices}}" wx:key="deviceId">
      <view class="device-item" 
            data-id="{{item.deviceId}}" 
            data-name="{{item.name}}"
            bindtap="connectDevice">
        <text class="device-name">{{item.name}}</text>
        <text class="rssi">信号: {{item.rssi}} dBm</text>
      </view>
    </block>
  </view>
  
  <!-- 发送按钮 -->
  <button type="warn" bindtap="sendWifiConfig" disabled="{{!connected}}">发送配置</button>
  
  <!-- 断开按钮 -->
  <button bindtap="disconnect" wx:if="{{connected}}">断开连接</button>
</view>
